   https://github.com/catppuccin/rofi (full licence: LICENSES/MIT-Catppuccin.txt in the dotfiles) */

* {
    /* Colors - Catppuccin Mocha base with Amber Peach */
    bg-col:      #4f1500;
    bg-col-alt:  #9b3e00;
    border-col:  #ff6600;    /* Amber Orange */
    selected-col: #9b3e00;
    orange:      #ff6600;    /* Amber Orange */
    fg-col:      #9b3e00;
    fg-col2:     #11111b;    /* Dark text for inside the orange labels */

    width: 600;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    height: 400px;
    border: 3px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
}

mainbox {
    background-color: @bg-col;
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 20px 20px 10px 20px;
}

prompt {
    background-color: @orange;
    padding: 6px 12px;
    text-color: @fg-col2;
    border-radius: 6px;
}

entry {
    padding: 6px 10px;
    text-color: @orange;      /* Typing color is now Orange */
    background-color: @bg-col; /* No more white box! */
    placeholder: "Choose or type in your desired place...";
    placeholder-color: @selected-col;
}

listview {
    border: 0px;
    padding: 10px 20px 20px 20px;
    columns: 1;
    lines: 8;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
}

/* This is what fixes that ugly white/blue selection */
element selected {
    background-color:  @selected-col; /* Subtle dark gray-blue background */
    text-color: @orange;              /* Text turns orange when highlighted */
    border: 1px;
    border-color: @orange;            /* Tiny orange border around selection */
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    background-color: inherit;
    margin: 0 10px 0 0;
}

configuration {
    display-drun: "󰀻 Search";
    display-run: "󰀻 Search-All";
    display-window: " Alt-Tab";
    display-dmenu: "󰖩 Network";
}